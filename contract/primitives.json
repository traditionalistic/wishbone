{
  "version": "1.0.0",
  "events": {
    "tap": "{}",
    "longPress": "{}",
    "appear": "{}",
    "disappear": "{}"
  },
  "dragEvents": {
    "dragEnd": "{x: number, y: number, vx: number, vy: number}"
  },
  "common": {
    "width": {
      "type": "number | \"fill\" | \"wrap\"",
      "default": "wrap"
    },
    "height": {
      "type": "number | \"fill\" | \"wrap\"",
      "default": "wrap"
    },
    "minWidth": {
      "type": "number"
    },
    "maxWidth": {
      "type": "number"
    },
    "minHeight": {
      "type": "number"
    },
    "maxHeight": {
      "type": "number"
    },
    "aspect": {
      "type": "number"
    },
    "padding": {
      "type": "number | {top?: number, bottom?: number, start?: number, end?: number, h?: number, v?: number}",
      "default": 0
    },
    "background": {
      "type": "paint"
    },
    "material": {
      "type": "\"thin\" | \"regular\" | \"thick\""
    },
    "corner": {
      "type": "number",
      "default": 0
    },
    "border": {
      "type": "{color: color, width: number}"
    },
    "clip": {
      "type": "bool",
      "default": false
    },
    "shadow": {
      "type": "{color: color, radius: number, x?: number, y?: number}"
    },
    "opacity": {
      "type": "number",
      "default": 1
    },
    "offsetX": {
      "type": "number",
      "default": 0
    },
    "offsetY": {
      "type": "number",
      "default": 0
    },
    "scale": {
      "type": "number",
      "default": 1
    },
    "rotation": {
      "type": "number",
      "default": 0
    },
    "zIndex": {
      "type": "number",
      "default": 0
    },
    "ignoreSafeArea": {
      "type": "\"none\" | \"top\" | \"bottom\" | \"all\"",
      "default": "none",
      "doc": "honored on the screen's root node only: by default the root is laid out inside the safe area (its background still extends behind the system bars); top/bottom/all lets content go edge-to-edge on those edges (use env.safeTop/env.safeBottom to pad manually)"
    }
  },
  "animatable": [
    "width",
    "height",
    "padding",
    "background",
    "corner",
    "opacity",
    "offsetX",
    "offsetY",
    "scale",
    "rotation",
    "color",
    "fill",
    "progress"
  ],
  "timelineProps": [
    "opacity",
    "scale",
    "offsetX",
    "offsetY",
    "rotation"
  ],
  "primitives": {
    "stack": {
      "children": true,
      "props": {
        "axis": {
          "type": "\"v\" | \"h\" | \"z\"",
          "default": "v"
        },
        "spacing": {
          "type": "number",
          "default": 0
        },
        "align": {
          "type": "\"start\" | \"center\" | \"end\" | \"topStart\" | \"top\" | \"topEnd\" | \"bottomStart\" | \"bottom\" | \"bottomEnd\"",
          "doc": "default: center for axis z, start otherwise; v: horizontal alignment of children, h: vertical, z: 9-way"
        }
      },
      "events": {}
    },
    "scroll": {
      "children": true,
      "props": {
        "axis": {
          "type": "\"v\" | \"h\"",
          "default": "v"
        },
        "spacing": {
          "type": "number",
          "default": 0
        },
        "align": {
          "type": "\"start\" | \"center\" | \"end\"",
          "default": "start"
        },
        "paging": {
          "type": "bool",
          "default": false
        },
        "indicators": {
          "type": "bool",
          "default": false
        },
        "lazy": {
          "type": "bool",
          "default": false
        }
      },
      "events": {},
      "doc": "exposes driver scroll.<id>.x / scroll.<id>.y (content offset, points)"
    },
    "grid": {
      "children": true,
      "props": {
        "columns": {
          "type": "number",
          "required": true
        },
        "spacing": {
          "type": "number",
          "default": 0
        },
        "rowSpacing": {
          "type": "number",
          "default": 0
        }
      },
      "events": {}
    },
    "spacer": {
      "children": false,
      "props": {
        "min": {
          "type": "number",
          "default": 0
        }
      },
      "events": {}
    },
    "text": {
      "children": false,
      "props": {
        "text": {
          "type": "string",
          "required": true
        },
        "style": {
          "type": "textStyle",
          "default": "@type.body"
        },
        "color": {
          "type": "color",
          "default": "@color.el16"
        },
        "textAlign": {
          "type": "\"start\" | \"center\" | \"end\"",
          "default": "start"
        },
        "maxLines": {
          "type": "number",
          "default": 0,
          "doc": "0 = unlimited"
        }
      },
      "events": {}
    },
    "image": {
      "children": false,
      "props": {
        "url": {
          "type": "string",
          "required": true
        },
        "fit": {
          "type": "\"fill\" | \"fit\"",
          "default": "fill"
        },
        "placeholder": {
          "type": "color",
          "default": "@color.bg2"
        }
      },
      "events": {}
    },
    "icon": {
      "children": false,
      "props": {
        "name": {
          "type": "icon",
          "required": true
        },
        "size": {
          "type": "number",
          "default": 24
        },
        "color": {
          "type": "color",
          "default": "@color.el16"
        }
      },
      "events": {}
    },
    "shape": {
      "children": false,
      "props": {
        "kind": {
          "type": "\"rect\" | \"circle\" | \"capsule\"",
          "default": "rect"
        },
        "fill": {
          "type": "paint"
        },
        "stroke": {
          "type": "{color: color, width: number}"
        },
        "trim": {
          "type": "{from: number, to: number}",
          "doc": "circle only: draws just this part of the stroke, as fractions of the circumference (each clamped to 0…1) from 12 o'clock clockwise, with round line caps; to <= from draws no stroke; fill is not trimmed"
        }
      },
      "events": {},
      "doc": "rect uses the common `corner` prop"
    },
    "textField": {
      "children": false,
      "props": {
        "value": {
          "type": "string",
          "default": ""
        },
        "placeholder": {
          "type": "string",
          "default": ""
        },
        "keyboard": {
          "type": "\"text\" | \"email\" | \"number\" | \"phone\"",
          "default": "text"
        },
        "secure": {
          "type": "bool",
          "default": false
        },
        "style": {
          "type": "textStyle",
          "default": "@type.body"
        },
        "color": {
          "type": "color",
          "default": "@color.el16"
        }
      },
      "events": {
        "change": "{value: string}",
        "submit": "{value: string}"
      },
      "sugar": {
        "bind": "state name: value = <name>, on.change += <name> = event.value"
      }
    },
    "lottie": {
      "children": false,
      "props": {
        "url": {
          "type": "string",
          "required": true
        },
        "loop": {
          "type": "bool",
          "default": true
        },
        "playing": {
          "type": "bool",
          "default": true
        },
        "progress": {
          "type": "number",
          "doc": "0…1; when set, drives the frame instead of playing"
        },
        "speed": {
          "type": "number",
          "default": 1
        }
      },
      "events": {
        "end": "{}"
      }
    },
    "rive": {
      "children": false,
      "props": {
        "url": {
          "type": "string",
          "required": true
        },
        "artboard": {
          "type": "string",
          "default": ""
        },
        "stateMachine": {
          "type": "string",
          "default": ""
        },
        "inputs": {
          "type": "map<bool | number>"
        }
      },
      "events": {
        "event": "{name: string}"
      }
    },
    "native": {
      "children": false,
      "props": {
        "name": {
          "type": "string",
          "required": true
        },
        "props": {
          "type": "map<any>"
        }
      },
      "events": {}
    }
  }
}
