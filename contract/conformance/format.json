[
 {
  "name": "fmt.number.group",
  "kind": "expr",
  "expr": "formatNumber(1990, 0)",
  "expect": "1 990"
 },
 {
  "name": "fmt.number.neg",
  "kind": "expr",
  "expr": "formatNumber(-1234.5, 1)",
  "expect": "-1 234.5"
 },
 {
  "name": "fmt.number.carry",
  "kind": "expr",
  "expr": "formatNumber(999.999, 2)",
  "expect": "1 000.00"
 },
 {
  "name": "fmt.number.halfaway",
  "kind": "expr",
  "expr": "formatNumber(0.125, 2)",
  "expect": "0.13"
 },
 {
  "name": "fmt.number.binary",
  "kind": "expr",
  "expr": "formatNumber(2.675, 2)",
  "expect": "2.67"
 },
 {
  "name": "fmt.number.small",
  "kind": "expr",
  "expr": "formatNumber(999, 0) + \"|\" + formatNumber(0.5, 0) + \"|\" + formatNumber(-0.5, 0)",
  "expect": "999|1|-1"
 },
 {
  "name": "fmt.number.pad",
  "kind": "expr",
  "expr": "formatNumber(0.05, 3)",
  "expect": "0.050"
 },
 {
  "name": "fmt.number.million",
  "kind": "expr",
  "expr": "formatNumber(1234567.891, 2)",
  "expect": "1 234 567.89"
 },
 {
  "name": "fmt.duration.hms",
  "kind": "expr",
  "expr": "formatDuration(3723000, \"hms\")",
  "expect": "01:02:03"
 },
 {
  "name": "fmt.duration.ms",
  "kind": "expr",
  "expr": "formatDuration(59999, \"ms\")",
  "expect": "00:59"
 },
 {
  "name": "fmt.duration.neg",
  "kind": "expr",
  "expr": "formatDuration(-5, \"hms\")",
  "expect": "00:00:00"
 },
 {
  "name": "fmt.duration.dhms",
  "kind": "expr",
  "expr": "formatDuration(90061000, \"dhms\")",
  "expect": "1:01:01:01"
 },
 {
  "name": "fmt.duration.bighours",
  "kind": "expr",
  "expr": "formatDuration(360000000, \"hms\")",
  "expect": "100:00:00"
 },
 {
  "name": "fmt.duration.countdown",
  "kind": "expr",
  "expr": "formatDuration(until - env.now, \"hms\")",
  "expect": "00:00:10",
  "script": "state until = 20000",
  "env": {
   "now": 10000
  }
 },
 {
  "name": "fmt.date.epoch",
  "kind": "expr",
  "expr": "formatDate(0, \"dateTime\")",
  "expect": "01.01.1970 00:00"
 },
 {
  "name": "fmt.date.date",
  "kind": "expr",
  "expr": "formatDate(1790000000000, \"date\")",
  "expect": "21.09.2026"
 },
 {
  "name": "fmt.date.tz",
  "kind": "expr",
  "expr": "formatDate(0, \"time\")",
  "expect": "03:00",
  "env": {
   "timeZone": "Europe/Moscow"
  }
 },
 {
  "name": "fmt.date.tz.dst",
  "kind": "expr",
  "expr": "formatDate(1783000000000, \"dateTime\")",
  "expect": "02.07.2026 15:46",
  "env": {
   "timeZone": "Europe/Berlin"
  }
 },
