{
 "id": "showcase.onboarding",
 "title": "Онбординг",
 "script": "// Онбординг (spec §9.1): входной таймлайн intro со stagger (autoplay), смена страниц в animate-транзакции со\n// slide-переходами, PageDots с неявной анимацией ширины, Lottie на каждой странице, Button с press-эффектом;\n// с последней страницы — navigate(\"showcase.promo\").\nstate page = 0\nlet pages = [\n  {id: \"draws\", title: \"Розыгрыши каждый день\", text: \"Призы от партнёров — от кофе до путешествий. Участвуйте прямо из приложения.\", lottie: \"/assets/lottie/pulse.json\", loop: true, tint: @color.accentPrimary, perks: [\"Новые розыгрыши каждое утро\", \"Честный выбор победителя\", \"Итоги — сразу в уведомлении\"]},\n  {id: \"tickets\", title: \"Копите билеты\", text: \"Билеты начисляются за покупки и задания. Чем их больше, тем выше шанс на приз.\", lottie: \"/assets/lottie/sparkle.json\", loop: true, tint: @color.warning, perks: [\"Билет за каждую покупку\", \"Бонусы за серию дней\", \"Двойные билеты по акциям\"]},\n  {id: \"prizes\", title: \"Забирайте призы\", text: \"Победителей объявляем в прямом эфире, а приз приходит за пару дней.\", lottie: \"/assets/lottie/check.json\", loop: false, tint: @color.success, perks: [\"Доставка или промокод\", \"История выигрышей в профиле\", \"Поддержка без выходных\"]}\n]\nlet last = page == pages.count - 1\nhandler next() {\n  if last {\n    navigate(\"showcase.promo\")\n  } else {\n    animate(@motion.smooth) { page = page + 1 }\n  }\n}",
 "timelines": [
  {"name": "intro", "autoplay": true, "tracks": [
   {"target": "top", "prop": "opacity", "keys": [{"t": 500, "v": 0}, {"t": 800, "v": 1, "ease": "easeOut"}]},
   {"target": "art", "prop": "opacity", "keys": [{"t": 0, "v": 0}, {"t": 300, "v": 1, "ease": "easeOut"}]},
   {"target": "art", "prop": "scale", "keys": [{"t": 0, "v": 0.6}, {"t": 700, "v": 1, "ease": "spring"}]},
   {"target": "title", "prop": "opacity", "keys": [{"t": 120, "v": 0}, {"t": 420, "v": 1, "ease": "easeOut"}]},
   {"target": "title", "prop": "offsetY", "keys": [{"t": 120, "v": 20}, {"t": 620, "v": 0, "ease": "spring"}]},
   {"target": "body", "prop": "opacity", "keys": [{"t": 220, "v": 0}, {"t": 520, "v": 1, "ease": "easeOut"}]},
   {"target": "body", "prop": "offsetY", "keys": [{"t": 220, "v": 20}, {"t": 720, "v": 0, "ease": "spring"}]},
   {"target": "perk", "prop": "opacity", "stagger": 90, "keys": [{"t": 360, "v": 0}, {"t": 660, "v": 1, "ease": "easeOut"}]},
   {"target": "perk", "prop": "offsetX", "stagger": 90, "keys": [{"t": 360, "v": -24}, {"t": 860, "v": 0, "ease": "spring"}]},
   {"target": "footer", "prop": "opacity", "keys": [{"t": 600, "v": 0}, {"t": 900, "v": 1, "ease": "easeOut"}]},
   {"target": "footer", "prop": "offsetY", "keys": [{"t": 600, "v": 32}, {"t": 1100, "v": 0, "ease": "spring"}]}
  ]}
 ],
 "root": {"type": "stack", "id": "root", "props": {"spacing": "@space.lg", "width": "fill", "height": "fill", "padding": "={h: @space.lg, top: @space.sm, bottom: @space.lg}", "background": "@color.bg1"}, "children": [

  {"type": "stack", "id": "top", "props": {"axis": "h", "align": "center", "width": "fill", "height": 44}, "children": [
   {"type": "text", "id": "step", "props": {"text": "=\"Шаг ${page + 1} из ${pages.count}\"", "style": "@type.captionStrong", "color": "@color.el9"}},
   {"type": "spacer", "id": "topGap"},
   {"type": "text", "id": "skip", "when": "!last", "transition": {"out": "fade"},
    "props": {"text": "Пропустить", "style": "@type.bodyMedium", "color": "@color.el9", "padding": "={v: @space.sm}", "opacity": "=self.pressed ? 0.5 : 1"},
    "animate": {"opacity": "@motion.press"},
    "on": {"tap": "navigate(\"showcase.promo\")"}, "a11y": {"role": "button"}}
  ]},

  {"type": "stack", "id": "pages", "props": {"axis": "z", "width": "fill", "height": "fill"}, "children": [
   {"type": "stack", "id": "slide", "repeat": {"over": "pages", "as": "p", "index": "i", "key": "p.id"}, "when": "i == page",
    "transition": {"in": "slide(end) + fade", "out": "slide(start) + fade"},
    "props": {"align": "center", "spacing": "@space.lg", "width": "fill"}, "children": [
     {"type": "stack", "id": "art", "props": {"axis": "z", "width": 220, "height": 220, "corner": "@radius.pill", "background": "=alpha(p.tint, 0.12)"}, "children": [
      {"type": "lottie", "id": "anim", "props": {"url": "=p.lottie", "loop": "=p.loop", "playing": "=i == page", "width": 180, "height": 180}, "a11y": {"hidden": true}}
     ]},
     {"type": "text", "id": "title", "props": {"text": "=p.title", "style": "@type.largeTitle", "textAlign": "center"}, "a11y": {"role": "header"}},
     {"type": "text", "id": "body", "props": {"text": "=p.text", "style": "@type.body", "color": "@color.el9", "textAlign": "center"}},
     {"type": "stack", "id": "perks", "props": {"spacing": "@space.md", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
      {"type": "stack", "id": "perk", "repeat": {"over": "p.perks", "as": "perk", "key": "perk"}, "props": {"axis": "h", "align": "center", "spacing": "@space.sm"}, "children": [
       {"type": "icon", "id": "perkIcon", "props": {"name": "@icon.check", "size": 18, "color": "=p.tint"}},
       {"type": "text", "id": "perkText", "props": {"text": "=perk", "style": "@type.bodyMedium"}}
      ]}
     ]}
    ]}
  ]},

  {"type": "stack", "id": "footer", "props": {"align": "center", "spacing": "@space.xl", "width": "fill"}, "children": [
   {"type": "PageDots", "id": "dots", "props": {"count": "=pages.count", "index": "=page"}},
   {"type": "Button", "id": "cta", "props": {"title": "=last ? \"Начать\" : \"Далее\"", "icon": "=last ? @icon.sparkles : null", "width": "fill"}, "on": {"tap": "next()"}}
  ]}
 ]}
}
