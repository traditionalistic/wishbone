{
 "id": "raffle.main",
 "title": "Розыгрыш",
 "script": "// Raffle (raffles spec §3.3) — the Stratoapp Modules/Raffle screen on raffle.* (stage GraphQL behind the Wishbone\n// server). Tabs «Задания / Призы / Таблица» (state tab); «Мои билеты» → raffle.tickets, «i» and the conditions cards\n// → present(raffle.rules); daily claim → call raffle.claimDaily + refresh(o); the «ФИО» toggle is optimistic over\n// call raffle.toggleHidden and rolls back on error. The leaderboard's first page is data `board`, further pages are\n// appended to `rows` when the last loaded row appears: the table tab has its own lazy scroll (`appear` fires near the\n// bottom). A saved «ФИО» toggle starts the table over: `board` is refreshed, `rows` dropped (they load again as the\n// table scrolls) and a page still in flight is discarded (`boardGen`) — loaded names keep the masking they came with.\n// The other tabs scroll eagerly — images in lazily materialized children may never load on iOS (AsyncImage).\n// Every table row is its own child of the lazy scroll and draws its slice of the rows card: with all rows in one child\n// that child outgrows the screen and SwiftUI's LazyVStack livelocks (100% CPU). The next page is asked for by the last\n// row, a new lazy item every page: a footer can stay materialized between pages (Compose does), so its `appear` stops.\n// As in Stratoapp, the table tab shows no «Мои билеты» and main-prize cards.\ndata o = raffle.overview()\ndata board = raffle.leaderboard({offset: 0, limit: 20})\nstate tab = \"tasks\"\nstate hiddenOverride: bool? = null\nstate claiming = false\n// the «ФИО» toggle's call is in flight: a second tap would flip the setting twice on the server\nstate toggling = false\nstate rows: list<{key: string, position: number, name: string, tickets: number, isMe: bool}> = []\nstate loadingMore = false\nstate boardDone = false\nstate moreFailed = false\n// bumped when the table starts over: a page asked for before it is discarded\nstate boardGen = 0\nlet tabIds = [\"tasks\", \"prizes\", \"table\"]\nlet hidden = hiddenOverride ?? o.hidden ?? false\nlet tickets = o.tickets ?? 0\nlet place = o.place ?? 0\nlet placeText = place > 0 ? str(place) + \" место\" : \"Места пока нет\"\n// progress = my tickets against the leader's (Stratoapp progressFraction)\nlet leader = board.items.first.tickets ?? 0\nlet progress = leader > 0 ? min(tickets / leader, 1) : place == 1 ? 1 : 0\nlet left = max((o.endsAt ?? 0) - env.now, 0)\nlet leftText = str(floor(left / 86400000)) + \"дн:\" + str(floor(left % 86400000 / 3600000)) + \"ч:\" + str(floor(left % 3600000 / 60000)) + \"м\"\nlet taskCount = o.tasks.count ?? 0\nlet boardCount = (board.items.count ?? 0) + rows.count\nlet boardMore = board != null && !boardDone && boardCount < (board.total ?? 0)\n// the first page's last row: rounds the card's bottom and asks for page 2 while `rows` is empty\nlet boardLast = (board.items.count ?? 0) - 1\n// Russian plural whatever env.locale is: the raffle strings are ru-only, plural() would follow the device language\nfn ticketsText(n: number): string = formatNumber(n, 0) + \" \" + (n % 10 == 1 && n % 100 != 11 ? \"билет\" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? \"билета\" : \"билетов\")\nhandler selectTab(i: number) {\n  animate(@motion.smooth) { tab = tabIds[i] ?? \"tasks\" }\n}\nhandler rules() {\n  present(\"raffle.rules\", {share: o.share ?? \"\"})\n}\nhandler claim() {\n  if !claiming {\n    claiming = true\n    let r = await call raffle.claimDaily()\n    if r.ok {\n      haptic(\"success\")\n      refresh(o)\n    } else {\n      host(\"toast\", {message: \"Не удалось получить ежедневную награду\"})\n    }\n    claiming = false\n  }\n}\nhandler toggleHidden() {\n  if !toggling {\n    toggling = true\n    let was = hidden\n    hiddenOverride = !was\n    let r = await call raffle.toggleHidden()\n    if r.ok {\n      hiddenOverride = r.value.hidden\n      boardGen = boardGen + 1\n      rows = []\n      boardDone = false\n      moreFailed = false\n      loadingMore = false\n      refresh(board)\n    } else {\n      hiddenOverride = was\n      host(\"toast\", {message: \"Не удалось сохранить настройку\"})\n    }\n    toggling = false\n  }\n}\nhandler loadMore() {\n  if !loadingMore && boardMore {\n    loadingMore = true\n    moreFailed = false\n    let gen = boardGen\n    let r = await call raffle.leaderboard({offset: boardCount, limit: 20})\n    if gen == boardGen {\n      if r.ok {\n        let items = r.value.items ?? []\n        rows = items.reduce(rows, (acc, x) => acc.append(x))\n        boardDone = items.count < 20\n      } else {\n        moreFailed = true\n      }\n      loadingMore = false\n    }\n  }\n}",
 "root": {"type": "stack", "id": "root", "props": {"width": "fill", "height": "fill", "background": "@color.bg1"}, "children": [

  {"type": "stack", "id": "header", "props": {"axis": "z", "width": "fill", "height": 52, "padding": "={h: @space.sm}"}, "children": [
   {"type": "text", "id": "headerTitle", "props": {"text": "Розыгрыш", "style": "@type.headingSmall", "maxLines": 1}, "a11y": {"role": "header"}},
   {"type": "stack", "id": "headerRow", "props": {"axis": "h", "align": "center", "width": "fill"}, "children": [
    {"type": "NavButton", "id": "backBtn", "props": {"icon": "@icon.back", "label": "Назад", "iconSize": 16}, "on": {"tap": "back()"}},
    {"type": "spacer", "id": "headerGap"},
    {"type": "IconButton", "id": "infoBtn", "props": {"icon": "@icon.info", "label": "Информация", "size": "small", "style": "plain"}, "on": {"tap": "rules()"}}
   ]}
  ]},

  {"type": "stack", "id": "error", "when": "o == null", "props": {"axis": "z", "width": "fill", "height": "fill"}, "children": [
   {"type": "EmptyState", "id": "errorState", "props": {"icon": "@icon.warning", "title": "Не удалось загрузить розыгрыш", "actionTitle": "Повторить"}, "on": {"action": "refresh(o)"}}
  ]},

  {"type": "scroll", "id": "page", "when": "o != null && tab != \"table\"", "transition": {"in": "fade", "out": "fade"}, "props": {"width": "fill", "height": "fill", "spacing": "@space.lg", "padding": "={h: @space.lg, top: @space.xs, bottom: @space.xl}"}, "children": [

   {"type": "SegmentedTabs", "id": "tabs", "props": {"items": ["Задания", "Призы", "Таблица"], "selected": "=tabIds.indexOf(tab)"}, "on": {"change": "selectTab(event.index)"}},

   {"type": "stack", "id": "progress",
    "props": {"spacing": "@space.sm", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"},
    "on": {"tap": "navigate(\"raffle.tickets\", {tickets: tickets, place: place})"},
    "a11y": {"label": "\"Мои билеты, \" + ticketsText(tickets) + \", \" + placeText", "role": "button"}, "children": [
    {"type": "stack", "id": "progressTop", "props": {"axis": "h", "align": "center", "spacing": "@space.xs", "width": "fill"}, "children": [
     {"type": "text", "id": "progressTitle", "props": {"text": "Мои билеты", "style": "@type.bodySmall", "color": "@color.el9", "width": "fill"}},
     {"type": "icon", "id": "progressIcon", "props": {"name": "@icon.ticket", "size": 16, "color": "@color.accentPrimary"}},
     {"type": "text", "id": "progressTickets", "props": {"text": "=ticketsText(tickets)", "style": "@type.bodySmallStrong", "maxLines": 1}}
    ]},
    {"type": "ProgressBar", "id": "progressBar", "props": {"value": "=progress", "width": "=env.screenWidth - 64"}},
    {"type": "stack", "id": "progressBottom", "props": {"axis": "h", "align": "center", "spacing": "@space.xs", "width": "fill"}, "children": [
     {"type": "text", "id": "progressPlace", "props": {"text": "=placeText", "style": "@type.bodySmallStrong", "width": "fill", "maxLines": 1}},
     {"type": "text", "id": "progressMore", "props": {"text": "Подробнее", "style": "@type.bodySmall", "color": "@color.accentPrimary"}},
     {"type": "icon", "id": "progressChevron", "props": {"name": "@icon.chevronRight", "size": 14, "color": "@color.accentPrimary"}}
    ]}
   ]},

   {"type": "stack", "id": "prize", "when": "o.mainPrize != null", "props": {"align": "center", "spacing": "@space.md", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"},
    "a11y": {"label": "\"Главный приз, \" + (o.mainPrize.title ?? \"\")"}, "children": [
    {"type": "stack", "id": "prizeHead", "props": {"axis": "h", "align": "center", "spacing": "@space.sm"}, "children": [
     {"type": "image", "id": "laurelLeft", "props": {"url": "/assets/raffle/laurel-left.png", "fit": "fit", "width": 16, "height": 30, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
     {"type": "stack", "id": "prizeTitles", "props": {"align": "center", "spacing": 2}, "children": [
      {"type": "text", "id": "prizeLabel", "props": {"text": "Главный приз", "style": "@type.caption", "color": "@color.el9"}},
      {"type": "text", "id": "prizeTitle", "props": {"text": "=o.mainPrize.title ?? \"\"", "style": "@type.headingSmall", "textAlign": "center", "maxLines": 1}}
     ]},
     {"type": "image", "id": "laurelRight", "props": {"url": "/assets/raffle/laurel-right.png", "fit": "fit", "width": 16, "height": 30, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}}
    ]},
    {"type": "image", "id": "prizeImg", "props": {"url": "=o.mainPrize.image ?? \"/assets/raffle/car.png\"", "fit": "fit", "width": "fill", "height": 150, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
    {"type": "text", "id": "prizeDate", "when": "o.endsAt != null", "props": {"text": "=\"Итоги розыгрыша проведем ${formatDate(o.endsAt ?? 0, \"date\")}\"", "style": "@type.caption", "color": "@color.el9", "textAlign": "center"}}
   ]},

   {"type": "stack", "id": "daily", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"},
    "props": {"spacing": "@space.md", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
    {"type": "text", "id": "dailyTitle", "props": {"text": "Заходи каждый день и получай ACoins", "style": "@type.bodyStrong"}},
    {"type": "scroll", "id": "dailyRail", "props": {"axis": "h", "spacing": "@space.sm", "width": "fill"}, "children": [
     {"type": "stack", "id": "day", "repeat": {"over": "o.daily.days", "key": "str(item.day)"},
      "props": {"align": "center", "spacing": "@space.xs", "width": 68, "padding": "={v: @space.sm}", "corner": "@radius.md",
       "background": "=item.state == \"claimed\" ? alpha(@color.success, 0.12) : @color.bg1",
       "border": "={color: item.state == \"available\" ? @color.accentPrimary : alpha(@color.accentPrimary, 0), width: 2}",
       "opacity": "=item.state == \"waiting\" ? 0.6 : 1"},
      "a11y": {"label": "\"День \" + str(item.day) + \", \" + str(item.amount)"}, "children": [
      {"type": "text", "id": "dayName", "props": {"text": "=\"День \" + str(item.day)", "style": "@type.caption", "color": "=item.state == \"claimed\" ? @color.success : @color.el9", "maxLines": 1}},
      {"type": "stack", "id": "dayAmount", "props": {"axis": "h", "align": "center", "spacing": 3}, "children": [
       {"type": "text", "id": "dayValue", "props": {"text": "=str(item.amount)", "style": "@type.bodySmallStrong"}},
       {"type": "image", "id": "dayCoin", "props": {"url": "/assets/raffle/coin.png", "fit": "fit", "width": 15, "height": 13, "placeholder": "=alpha(@color.bg1, 0)"}, "a11y": {"hidden": true}}
      ]},
      {"type": "icon", "id": "dayState", "props": {"name": "=item.state == \"claimed\" ? @icon.check : @icon.clock", "size": 16,
       "color": "=item.state == \"claimed\" ? @color.success : item.state == \"available\" ? @color.accentPrimary : @color.el9"}}
     ]}
    ]},
    {"type": "Button", "id": "claimBtn", "when": "o.daily.claimAmount != null", "props": {"title": "=\"Забрать ${o.daily.claimAmount ?? 0}\"", "loading": "=claiming", "width": "fill"}, "on": {"tap": "claim()"}}
   ]},

   {"type": "stack", "id": "conditions", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"},
    "props": {"axis": "h", "align": "center", "spacing": "@space.sm", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"},
    "on": {"tap": "rules()"}, "a11y": {"label": "\"Как выиграть главный приз?\"", "role": "button"}, "children": [
    {"type": "stack", "id": "conditionsText", "props": {"spacing": 2, "width": "fill"}, "children": [
     {"type": "text", "id": "conditionsTitle", "props": {"text": "Как выиграть главный приз?", "style": "@type.bodyStrong"}},
     {"type": "text", "id": "conditionsSub", "props": {"text": "Заработай больше всех билетов!", "style": "@type.caption", "color": "@color.el9"}}
    ]},
    {"type": "icon", "id": "conditionsChevron", "props": {"name": "@icon.chevronRight", "size": 16, "color": "@color.el9"}}
   ]},

   {"type": "stack", "id": "tasks", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"}, "props": {"spacing": "@space.md", "width": "fill"}, "children": [
    {"type": "text", "id": "tasksSection", "props": {"text": "Задания", "style": "@type.headingSmall"}, "a11y": {"role": "header"}},
    {"type": "stack", "id": "tasksCard", "props": {"width": "fill", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
     {"type": "stack", "id": "tasksHead", "props": {"axis": "h", "align": "center", "spacing": "@space.md", "width": "fill", "padding": "@space.lg"}, "children": [
      {"type": "image", "id": "tasksGift", "props": {"url": "/assets/raffle/gift.png", "fit": "fit", "width": 52, "height": 56, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
      {"type": "stack", "id": "tasksHeadText", "props": {"spacing": "@space.xs", "width": "fill"}, "children": [
       {"type": "text", "id": "tasksTitle", "props": {"text": "Получай билеты за задания", "style": "@type.bodyStrong"}},
       {"type": "stack", "id": "tasksTimer", "when": "o.endsAt != null", "props": {"axis": "h", "align": "center"}, "children": [
        {"type": "text", "id": "tasksTimerLabel", "props": {"text": "Осталось: ", "style": "@type.captionMedium", "color": "@color.el9"}},
        {"type": "text", "id": "tasksTimerValue", "props": {"text": "=leftText", "style": "@type.captionStrong", "color": "@color.accentPrimary", "maxLines": 1}}
       ]}
      ]}
     ]},
     {"type": "Divider", "id": "tasksDivider", "props": {"padding": "={h: @space.lg}"}},
     {"type": "text", "id": "tasksEmpty", "when": "taskCount == 0", "props": {"text": "Заданий пока нет", "style": "@type.bodySmall", "color": "@color.el9", "textAlign": "center", "width": "fill", "padding": "={v: @space.xl}"}},
     {"type": "stack", "id": "task", "repeat": {"over": "o.tasks", "key": "item.id"}, "props": {"width": "fill"}, "children": [
      {"type": "Divider", "id": "taskDivider", "when": "index > 0", "props": {"padding": "={h: @space.lg}"}},
      {"type": "stack", "id": "taskBody", "props": {"spacing": "@space.xs", "width": "fill", "padding": "@space.lg"}, "children": [
       {"type": "stack", "id": "taskHead", "props": {"axis": "h", "align": "center", "spacing": "@space.sm", "width": "fill"}, "children": [
        {"type": "stack", "id": "taskIcon", "props": {"axis": "z", "width": 32, "height": 32}, "children": [
         {"type": "image", "id": "taskImg", "when": "item.icon != null", "props": {"url": "=item.icon ?? \"\"", "fit": "fit", "width": 32, "height": 32, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
         {"type": "icon", "id": "taskGlyph", "when": "item.icon == null", "props": {"name": "@icon.star", "size": 22, "color": "@color.accentPrimary"}}
        ]},
        {"type": "text", "id": "taskName", "props": {"text": "=item.name", "style": "@type.bodyStrong", "width": "fill", "maxLines": 2}},
        {"type": "text", "id": "taskTickets", "props": {"text": "=\"+\" + ticketsText(item.tickets)", "style": "@type.captionStrong", "color": "@color.accentPrimary", "maxLines": 1}}
       ]},
       {"type": "text", "id": "taskDesc", "when": "item.description != \"\"", "props": {"text": "=item.description", "style": "@type.bodySmall", "color": "@color.el9"}},
       {"type": "stack", "id": "taskCooldown", "when": "(item.cooldownUntil ?? 0) > env.now", "props": {"axis": "h", "align": "center", "spacing": "@space.xs", "padding": "={top: @space.xs}"}, "children": [
        {"type": "icon", "id": "cooldownIcon", "props": {"name": "@icon.clock", "size": 14, "color": "@color.warning"}},
        {"type": "text", "id": "cooldownText", "props": {"text": "=\"Доступно через \" + formatDuration((item.cooldownUntil ?? 0) - env.now, \"hms\")", "style": "@type.captionStrong", "color": "@color.warning"}}
       ]},
       {"type": "stack", "id": "taskProgress", "repeat": {"over": "item.progress", "as": "p", "index": "pi"}, "props": {"axis": "h", "align": "center", "spacing": "@space.xs", "padding": "={top: 2}"}, "children": [
        {"type": "text", "id": "progressLabel", "props": {"text": "=p.label", "style": "@type.caption", "color": "@color.el9"}},
        {"type": "text", "id": "progressValue", "props": {"text": "=p.value", "style": "@type.captionStrong"}},
        {"type": "icon", "id": "progressTicket", "when": "p.ticket", "props": {"name": "@icon.ticket", "size": 14, "color": "@color.accentPrimary"}}
       ]}
      ]}
     ]}
    ]}
   ]},

   {"type": "stack", "id": "invites", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"},
    "props": {"axis": "h", "align": "center", "spacing": "@space.sm", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"},
    "on": {"tap": "navigate(\"raffle.invites\")"}, "a11y": {"label": "\"Мои приглашения\"", "role": "button"}, "children": [
    {"type": "text", "id": "invitesTitle", "props": {"text": "Мои приглашения", "style": "@type.bodyStrong", "width": "fill"}},
    {"type": "icon", "id": "invitesChevron", "props": {"name": "@icon.chevronRight", "size": 16, "color": "@color.el9"}}
   ]},

   {"type": "stack", "id": "referral", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"},
    "props": {"spacing": "@space.sm", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
    {"type": "stack", "id": "referralHead", "props": {"axis": "h", "align": "center", "spacing": "@space.md", "width": "fill"}, "children": [
     {"type": "stack", "id": "referralIcon", "props": {"axis": "z", "width": 44, "height": 44, "corner": "@radius.pill", "background": "=alpha(@color.accentPrimary, 0.12)"}, "children": [
      {"type": "icon", "id": "referralGlyph", "props": {"name": "@icon.user", "size": 22, "color": "@color.accentPrimary"}}
     ]},
     {"type": "text", "id": "referralTitle", "props": {"text": "Получи 30 билетов за каждого друга", "style": "@type.bodyStrong", "width": "fill"}}
    ]},
    {"type": "text", "id": "referralSub", "props": {"text": "Награда начислится, когда друг зарегистрируется", "style": "@type.bodySmall", "color": "@color.el9"}},
    {"type": "text", "id": "referralHint", "props": {"text": "Количество билетов не ограничено.", "style": "@type.caption", "color": "@color.el9"}},
    {"type": "Button", "id": "referralBtn", "when": "o.share != null", "props": {"title": "Пригласить друзей", "icon": "@icon.share", "width": "fill", "padding": "={top: @space.xs}"},
     "on": {"tap": "host(\"share\", {text: o.share ?? \"\"})"}}
   ]},

   {"type": "stack", "id": "settings", "when": "tab == \"tasks\"", "transition": {"in": "fade", "out": "fade"},
    "props": {"spacing": "@space.xs", "width": "fill", "padding": "={h: @space.lg, top: @space.lg, bottom: @space.sm}", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
    {"type": "text", "id": "settingsTitle", "props": {"text": "Настройки розыгрыша", "style": "@type.bodyStrong"}, "a11y": {"role": "header"}},
    {"type": "Toggle", "id": "showName", "props": {"title": "Показывать ФИО в таблице", "value": "=!hidden", "enabled": "=!toggling"}, "on": {"change": "toggleHidden()"}}
   ]},

   {"type": "stack", "id": "prizes", "when": "tab == \"prizes\"", "transition": {"in": "fade", "out": "fade"}, "props": {"spacing": "@space.md", "width": "fill"}, "children": [
    {"type": "text", "id": "prizesTitle", "props": {"text": "Призы", "style": "@type.headingSmall"}, "a11y": {"role": "header"}},
    {"type": "grid", "id": "prizesGrid", "props": {"columns": 2, "spacing": "@space.md", "rowSpacing": "@space.md", "width": "fill"}, "children": [
     {"type": "stack", "id": "prizeCard", "repeat": {"over": "o.prizes", "key": "str(item.rank)"},
      "props": {"spacing": "@space.sm", "width": "fill", "padding": "@space.md", "background": "@color.bg1Elevated", "corner": "@radius.lg"},
      "a11y": {"label": "str(item.rank) + \" место, \" + item.title + \", от \" + str(item.tickets)"}, "children": [
      {"type": "stack", "id": "prizeMedia", "props": {"axis": "z", "align": "topStart", "width": "fill"}, "children": [
       {"type": "image", "id": "prizeCardImg", "props": {"url": "=item.image ?? \"/assets/raffle/coin.png\"", "fit": "fit", "width": "fill", "height": 104, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
       {"type": "Badge", "id": "prizeRank", "props": {"title": "=\"#\" + str(item.rank)", "size": "sm"}}
      ]},
      {"type": "Badge", "id": "prizeFrom", "props": {"title": "=\"от \" + formatNumber(item.tickets, 0)", "style": "accent", "size": "sm"}},
      {"type": "stack", "id": "prizeName", "props": {"axis": "z", "align": "topStart", "width": "fill", "height": 42}, "children": [
       {"type": "text", "id": "prizeNameText", "props": {"text": "=item.title", "style": "@type.bodySmallStrong", "maxLines": 2}}
      ]}
     ]}
    ]}
   ]}
  ]},

  {"type": "scroll", "id": "tablePage", "when": "o != null && tab == \"table\"", "transition": {"in": "fade", "out": "fade"}, "props": {"lazy": true, "width": "fill", "height": "fill", "padding": "={h: @space.lg, top: @space.xs, bottom: @space.xl}"}, "children": [

   {"type": "stack", "id": "tableTop", "props": {"spacing": "@space.lg", "width": "fill", "padding": "={bottom: @space.md}"}, "children": [
    {"type": "SegmentedTabs", "id": "tableTabs", "props": {"items": ["Задания", "Призы", "Таблица"], "selected": "=tabIds.indexOf(tab)"}, "on": {"change": "selectTab(event.index)"}},
    {"type": "stack", "id": "table", "props": {"spacing": "@space.md", "width": "fill"}, "children": [
     {"type": "stack", "id": "tableHead", "props": {"axis": "h", "align": "center", "spacing": "@space.md", "width": "fill", "padding": "@space.lg", "background": "@color.bg1Elevated", "corner": "@radius.lg"}, "children": [
      {"type": "image", "id": "cup", "props": {"url": "/assets/raffle/cup.png", "fit": "fit", "width": 42, "height": 54, "placeholder": "=alpha(@color.bg1Elevated, 0)"}, "a11y": {"hidden": true}},
      {"type": "stack", "id": "tableHeadText", "props": {"spacing": "@space.xs", "width": "fill"}, "children": [
       {"type": "text", "id": "tableTitle", "props": {"text": "Таблица участников", "style": "@type.headingSmall"}, "a11y": {"role": "header"}},
       {"type": "stack", "id": "tableRules", "props": {"axis": "h", "align": "center", "spacing": "@space.xs"}, "on": {"tap": "rules()"}, "a11y": {"label": "\"Условия начисления\"", "role": "button"}, "children": [
        {"type": "icon", "id": "tableRulesIcon", "props": {"name": "@icon.info", "size": 14, "color": "@color.accentPrimary"}},
        {"type": "text", "id": "tableRulesText", "props": {"text": "Условия начисления", "style": "@type.bodySmall", "color": "@color.accentPrimary"}}
       ]}
      ]}
     ]},
     {"type": "stack", "id": "tableError", "when": "board == null", "props": {"align": "center", "width": "fill"}, "children": [
      {"type": "EmptyState", "id": "tableErrorState", "props": {"icon": "@icon.warning", "title": "Не удалось загрузить розыгрыш", "actionTitle": "Повторить"}, "on": {"action": "refresh(board)"}}
     ]}
    ]}
   ]},

   {"type": "stack", "id": "row", "repeat": {"over": "board.items"}, "on": {"appear": "if rows.count == 0 && index == boardLast {\n  loadMore()\n}"},
    "props": {"axis": "z", "align": "=index == 0 ? \"bottom\" : \"top\"", "width": "fill", "background": "@color.bg1Elevated", "corner": "=index == 0 || rows.count == 0 && index == boardLast ? @radius.lg : 0"}, "children": [
    {"type": "stack", "id": "rowPatch", "when": "(index == 0) != (rows.count == 0 && index == boardLast)", "props": {"width": "fill", "height": "@radius.lg", "background": "@color.bg1Elevated"}},
    {"type": "stack", "id": "rowPad", "props": {"width": "fill", "padding": "={h: @space.sm, top: index == 0 ? @space.sm : 1, bottom: rows.count == 0 && index == boardLast ? @space.sm : 1}"}, "children": [
     {"type": "stack", "id": "rowBody",
      "props": {"axis": "h", "align": "center", "spacing": "@space.md", "width": "fill", "padding": "={h: @space.md, v: 10}", "corner": "@radius.md",
       "background": "=item.isMe ? alpha(@color.accentPrimary, 0.14) : alpha(@color.accentPrimary, 0)"}, "children": [
      {"type": "text", "id": "rowPos", "props": {"text": "=\"#\" + str(item.position)", "style": "@type.captionStrong", "color": "=item.isMe ? @color.accentPrimary : @color.el9", "minWidth": 36, "maxLines": 1}},
      {"type": "text", "id": "rowName", "props": {"text": "=item.name", "style": "=item.isMe ? @type.bodySmallStrong : @type.bodySmall", "width": "fill", "maxLines": 1}},
      {"type": "text", "id": "rowTickets", "props": {"text": "=formatNumber(item.tickets, 0)", "style": "@type.bodySmallStrong", "maxLines": 1}},
      {"type": "icon", "id": "rowTicket", "props": {"name": "@icon.ticket", "size": 14, "color": "@color.accentPrimary"}}
     ]}
    ]}
   ]},
   {"type": "stack", "id": "moreRow", "repeat": {"over": "rows"}, "transition": {"in": "fade"}, "on": {"appear": "if index == rows.count - 1 {\n  loadMore()\n}"},
    "props": {"axis": "z", "align": "top", "width": "fill", "background": "@color.bg1Elevated", "corner": "=index == rows.count - 1 ? @radius.lg : 0"}, "children": [
    {"type": "stack", "id": "moreRowPatch", "when": "index == rows.count - 1", "props": {"width": "fill", "height": "@radius.lg", "background": "@color.bg1Elevated"}},
    {"type": "stack", "id": "moreRowPad", "props": {"width": "fill", "padding": "={h: @space.sm, top: 1, bottom: index == rows.count - 1 ? @space.sm : 1}"}, "children": [
     {"type": "stack", "id": "moreRowBody",
      "props": {"axis": "h", "align": "center", "spacing": "@space.md", "width": "fill", "padding": "={h: @space.md, v: 10}", "corner": "@radius.md",
       "background": "=item.isMe ? alpha(@color.accentPrimary, 0.14) : alpha(@color.accentPrimary, 0)"}, "children": [
      {"type": "text", "id": "moreRowPos", "props": {"text": "=\"#\" + str(item.position)", "style": "@type.captionStrong", "color": "=item.isMe ? @color.accentPrimary : @color.el9", "minWidth": 36, "maxLines": 1}},
      {"type": "text", "id": "moreRowName", "props": {"text": "=item.name", "style": "=item.isMe ? @type.bodySmallStrong : @type.bodySmall", "width": "fill", "maxLines": 1}},
      {"type": "text", "id": "moreRowTickets", "props": {"text": "=formatNumber(item.tickets, 0)", "style": "@type.bodySmallStrong", "maxLines": 1}},
      {"type": "icon", "id": "moreRowTicket", "props": {"name": "@icon.ticket", "size": 14, "color": "@color.accentPrimary"}}
     ]}
    ]}
   ]},

   {"type": "stack", "id": "tableFooter", "when": "boardMore", "props": {"axis": "z", "width": "fill", "height": "=56 + @space.lg", "padding": "={top: @space.lg}"}, "children": [
    {"type": "Loader", "id": "tableLoader", "when": "!moreFailed", "props": {"size": 28}},
    {"type": "Button", "id": "tableRetry", "when": "moreFailed", "props": {"title": "Повторить", "style": "secondary", "size": "compact"}, "on": {"tap": "loadMore()"}}
   ]}
  ]}
 ]}
}
